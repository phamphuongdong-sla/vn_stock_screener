swingLen     = input.int(5, "Độ dài Swing", minval=2, maxval=25, group=gENG, inline="e1")
srchAtr      = input.float(1.20, "Vùng tìm kiếm (ATR)", minval=0.20, maxval=3.00, step=0.05, group=gENG, inline="e1", tooltip=tt8+"\n\n"+tt9)
nodeMin      = input.float(0.08, "Khối lượng nút tối thiểu", minval=0.0, maxval=1.0, step=0.01, group=gENG, inline="e2")
