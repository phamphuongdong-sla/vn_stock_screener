var string tt2  = "Số hàng mức giá chia nhỏ trong hồ sơ. Càng nhiều hàng thì độ chi tiết mức giá gom hàng càng cao."
var string tt3  = "Độ rộng tối đa của cột hồ sơ khối lượng ở mép phải biểu đồ."
var string tt4  = "Khoảng cách lề từ nến hiện tại đến cột hồ sơ khối lượng."
var string tt5  = "Bật/Tắt hiển thị cột Hồ sơ khối lượng Mua/Bán ở bên phải."
var string tt6  = "Làm nổi bật mức giá có khối lượng giao dịch lớn nhất (Đường cam POC)."
var string tt7  = "Vẽ viền làm nổi bật các hàng khối lượng trùng với Hỗ trợ/Kháng cự đang hoạt động."
var string tt8  = "Số nến xác nhận đỉnh đáy Swing (Mặc định 5 nến)."
var string tt9  = "Khoảng cách tối đa (theo ATR) để tìm kiếm nút khối lượng gom hàng lớn quanh đỉnh/đáy thô."
var string tt10 = "Tỷ lệ khối lượng nút tối thiểu so với POC."
var string tt11 = "Bằng chứng dòng tiền tối thiểu để công nhận mức Hỗ trợ/Kháng cự hợp lệ."
var string tt12 = "Lực hút mức giá về phía nút khối lượng lớn nhất."
var string tt13 = "Điểm số tối thiểu (0-100) để giữ lại mức Hỗ trợ/Kháng cự trên biểu đồ (Khuyên dùng: 30 - 45)."
var string tt14 = "Số lượng đường cản tối đa trên biểu đồ để tránh rối mắt (Bản gốc là 20)."
var string tt15 = "Gộp các đường cản nằm quá gần nhau."
var string tt16 = "Biên độ nến đóng cửa vượt qua cản để xác nhận phá vỡ."
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

