indicator("Hồ Sơ Mua/Bán + Hỗ Trợ Kháng Cự Động (Bản Gốc Đầy Đủ + Điểm Mua Bán)", overlay=true, max_lines_count=250, max_labels_count=500, max_boxes_count=300, max_bars_back=5000)

