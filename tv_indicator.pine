showSignals  = input.bool(true, "Bật Tín Hiệu Đi Lệnh", group=gSIG)
showBuyDo    = input.bool(true, "🟢 MUA DÒ (20-30%)", group=gSIG, inline="b")
showBuyChinh = input.bool(true, "💎 MUA CHÍNH (Đủ 100%)", group=gSIG, inline="b")
showBanDo    = input.bool(true, "🟡 BÁN DÒ (Chốt 30-50%)", group=gSIG, inline="s")
showBanHet   = input.bool(true, "🚨 BÁN HẾT (Thoát Hàng)", group=gSIG, inline="s")
minSigScore  = input.float(45.0, "Điểm Cản Tối Thiểu Phát Tín Hiệu", minval=30.0, maxval=90.0, step=5.0, group=gSIG)
volBreakX    = input.float(1.30, "Hệ Số Volume Mua Chính (x MA20)", minval=1.1, maxval=2.5, step=0.1, group=gSIG)

// 2. Bảng điều khiển HUD
showHUD      = input.bool(true, "Bật Bảng HUD Góc Màn Hình (Không Che Nến)", group=gHUD)
hudPos       = input.string("Góc Trên Bên Phải", "Vị Trí Bảng HUD", options=["Góc Trên Bên Phải", "Góc Dưới Bên Phải", "Góc Dưới Bên Trái"], group=gHUD)

// 3. Hồ sơ khối lượng
showProf     = input.bool(true, "Hiện Hồ Sơ Khối Lượng", group=gPROF, inline="p1")
showPoc      = input.bool(true, "Tia Laser Cam POC", group=gPROF, inline="p1")
