//@version=5
indicator("Volume AI & Keltner - Premium UI", overlay = true, max_labels_count = 500)

// =========================================================================
// 1. CÀI ĐẶT THAM SỐ (EXPERT SETTINGS)
// =========================================================================
group_ai = "🧠 Lõi Dữ Liệu Học Máy (KNN AI)"
k = input.int(3, 'Số láng giềng (k)', group=group_ai)
n_data = input.int(10, 'Khối lượng Dữ liệu (n)', group=group_ai)
KNN_PriceLen = input.int(20, 'Độ trượt Giá AI', group=group_ai)
KNN_STLen = input.int(100, 'Độ trượt Trend AI', group=group_ai)

group_st = "⚡ Lõi Đột Phá (Keltner Breakout)"
len = input.int(10, 'Chu kỳ Volume (VWMA)', group=group_st)
factor = input.float(2.8, 'Độ nhạy Keltner', step=0.1, group=group_st)
atrLength = input.int(14, 'Chu kỳ ATR (Quản trị vốn)', group=group_st)
anti_repaint = input.bool(true, 'Chống Repaint (Chờ nến đóng cửa)', group=group_st)

group_tp = "🎯 Tỷ lệ Rủi ro/Lợi nhuận (R:R)"
rr_1 = input.float(1.0, "Mức Chốt lời 1 (TP1)", step=0.1, group=group_tp)
rr_2 = input.float(1.5, "Mức Chốt lời 2 (TP2)", step=0.1, group=group_tp)
rr_3 = input.float(2.5, "Mức Chốt lời 3 (TP3)", step=0.1, group=group_tp)

// =========================================================================
// 2. BẢNG MÀU CAO CẤP (NEON & GLASS)
// =========================================================================
c_bull = color.rgb(0, 255, 136) // Xanh Neon
c_bear = color.rgb(255, 51, 102) // Đỏ Hồng Neon
c_text = color.rgb(240, 240, 240)
c_glass = color.new(#080808, 60) // Kính đen mờ hiện đại

// =========================================================================
// 3. THUẬT TOÁN 1: KELTNER SUPERTREND (Theo VWMA)
// =========================================================================
vwma_val = ta.vwma(close, len)
atr = ta.atr(len)

upperBand = vwma_val + factor * atr
lowerBand = vwma_val - factor * atr

prevLowerBand = nz(lowerBand[1])
prevUpperBand = nz(upperBand[1])

lowerBand := lowerBand > prevLowerBand or close[1] < prevLowerBand ? lowerBand : prevLowerBand
upperBand := upperBand < prevUpperBand or close[1] > prevUpperBand ? upperBand : prevUpperBand

int direction = na
float st_value = na
prevSuperTrend = st_value[1]

if na(atr[1])
    direction := 1
else if prevSuperTrend == prevUpperBand
    direction := close > upperBand ? -1 : 1
else
    direction := close < lowerBand ? 1 : -1

st_value := direction == -1 ? lowerBand : upperBand

// =========================================================================
// 4. THUẬT TOÁN 2: MẠNG HỌC MÁY KNN (Volume AI)
// =========================================================================
price_wma = ta.wma(close, KNN_PriceLen)
st_wma = ta.wma(st_value, KNN_STLen)

data = array.new_float(n_data)
labels = array.new_int(n_data)

for i = 0 to n_data - 1 by 1
    data.set(i, st_value[i])
    label_i = price_wma[i] > st_wma[i] ? 1 : 0
    labels.set(i, label_i)

distance(x1, x2) => math.abs(x1 - x2)

knn_weighted(data_arr, label_arr, k_val, current_x) =>
    n1 = data_arr.size()
    distances = array.new_float(n1)
    indices = array.new_int(n1)
    
    for i = 0 to n1 - 1 by 1
        distances.set(i, distance(current_x, data_arr.get(i)))
        indices.set(i, i)
        
    for i = 0 to n1 - 2 by 1
        for j = 0 to n1 - i - 2 by 1
            if distances.get(j) > distances.get(j + 1)
                tempDist = distances.get(j)
                distances.set(j, distances.get(j + 1))
                distances.set(j + 1, tempDist)
                tempIndex = indices.get(j)
                indices.set(j, indices.get(j + 1))
                indices.set(j + 1, tempIndex)
                
    weighted_sum = 0.0
    total_weight = 0.0
    
    for i = 0 to k_val - 1 by 1
        index = indices.get(i)
        lbl_i = label_arr.get(index)
        weight_i = 1 / (distances.get(i) + 1e-6)
        weighted_sum := weighted_sum + weight_i * lbl_i
        total_weight := total_weight + weight_i
        
    weighted_sum / total_weight

ai_predict = knn_weighted(data, labels, k, st_value)
ai_trend = ai_predict == 1 ? 1 : -1 

// =========================================================================
// 5. ĐỒ HỌA: MÂY ĐA LỚP & ĐƯỜNG NEON GLOW
// =========================================================================
trend_color = ai_trend == 1 ? c_bull : c_bear
barcolor(trend_color)

cloudRef = ta.ema((open + close) / 2, 10)
p_st = plot(st_value, color=na, display=display.none)
p_cloudRef = plot(cloudRef, color=na, display=display.none)

fill(p_st, p_cloudRef, color=color.new(trend_color, 85), title='Volume Cloud')

plot(st_value, color=color.new(trend_color, 75), linewidth=6, title="Neon Haze")
plot(st_value, color=trend_color, linewidth=2, title="Neon Core")

// =========================================================================
// 6. CƠ CHẾ KÍCH HOẠT LỆNH THÔNG MINH (STATE MACHINE)
// =========================================================================
st_bull = direction == -1
st_bear = direction == 1
is_valid = anti_repaint ? barstate.isconfirmed : true

var int trade_state = 0
bull = false
bear = false

if st_bull and (ai_trend == 1) and is_valid and trade_state <= 0
    bull := true
    trade_state := 1

if st_bear and (ai_trend == -1) and is_valid and trade_state >= 0
    bear := true
    trade_state := -1

// MŨI TÊN TÍN HIỆU GỌN GÀNG, KHÔNG DÂY NHỢ
plotshape(bull, title="Tín hiệu MUA", text="MUA", textcolor=c_bull, style=shape.triangleup, location=location.belowbar, color=c_bull, size=size.small)
plotshape(bear, title="Tín hiệu BÁN", text="BÁN", textcolor=c_bear, style=shape.triangledown, location=location.abovebar, color=c_bear, size=size.small)

// =========================================================================
// 7. BẢNG ĐIỀU KHIỂN CẬP NHẬT TP/SL
// =========================================================================
atr_val = ta.atr(atrLength)

f_num(val) => str.format("{0,number,#,###.##}", val)

var table tb = table.new(position.bottom_right, 2, 6, bgcolor=c_glass, border_width=0)

if barstate.isfirst
    table.cell(tb, 0, 0, "DASHBOARD (AI + KELTNER)", text_color=color.new(c_text, 30), text_halign=text.align_center, text_size=size.small)
    table.merge_cells(tb, 0, 0, 1, 0)
    table.cell(tb, 0, 1, "Trạng thái lệnh:", text_color=color.new(c_text, 30), text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 2, "Giá Kích Hoạt:", text_color=color.new(c_text, 30), text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 3, "Mục Tiêu 1:", text_color=color.new(c_text, 30), text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 4, "Mục Tiêu 2:", text_color=color.new(c_text, 30), text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 5, "Cắt Lỗ (SL):", text_color=color.new(c_text, 30), text_size=size.small, text_halign=text.align_left)

if bull or bear
    float sl = na, float tp1 = na, float tp2 = na, float tp3 = na, float risk = na
    
    if bull
        sl := low - (atr_val * 1.5)
        risk := close - sl
        tp1 := close + (risk * rr_1), tp2 := close + (risk * rr_2)
        table.cell(tb, 1, 1, "MUA LÊN (LONG)", text_color=c_bull, text_size=size.small, text_halign=text.align_right)
        
    if bear
        sl := high + (atr_val * 1.5)
        risk := sl - close
        tp1 := close - (risk * rr_1), tp2 := close - (risk * rr_2)
        table.cell(tb, 1, 1, "BÁN XUỐNG (SHORT)", text_color=c_bear, text_size=size.small, text_halign=text.align_right)

    // Cập nhật giá trị vào Bảng
    table.cell(tb, 1, 2, f_num(close), text_color=c_text, text_size=size.small, text_halign=text.align_right)
    table.cell(tb, 1, 3, f_num(tp1), text_color=c_bull, text_size=size.small, text_halign=text.align_right)
    table.cell(tb, 1, 4, f_num(tp2), text_color=c_bull, text_size=size.small, text_halign=text.align_right)
    table.cell(tb, 1, 5, f_num(sl), text_color=c_bear, text_size=size.small, text_halign=text.align_right)

// =========================================================================
// 8. HỆ THỐNG CẢNH BÁO TỰ ĐỘNG
// =========================================================================
alertcondition(bull, title="🚀 Lệnh MUA Chuẩn", message="Hợp lưu AI & Keltner kích hoạt lệnh MUA")
alertcondition(bear, title="🔻 Lệnh BÁN Chuẩn", message="Hợp lưu AI & Keltner kích hoạt lệnh BÁN")